{
  "name": "@uniswap/tamperproof-transactions",
  "version": "1.1.0",
  "type": "module",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "repository": "git@github.com:Uniswap/tamperproof-transactions.git",
  "author": "Uniswap Labs Security <security@uniswap.org>",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "run:test-sign": "yarn build && node --experimental-specifier-resolution=node dist/scripts/test-sign.js",
    "prepare": "husky"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "dohjs": "^0.3.3"
  }
}
